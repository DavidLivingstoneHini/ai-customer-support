# ── Application ───────────────────────────────────────────────
APP_ENV=development
APP_NAME="AI Customer Support Assistant"
APP_VERSION=1.0.0

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=acs_user
POSTGRES_PASSWORD=developer123
POSTGRES_DB=ai_support
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://acs_user:developer123@postgres:5432/ai_support

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379/0

# ── JWT ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=2aebf9002ab7421a6a86613f16ac33dae7bc43b74792ff9949d783a5beed7821
JWT_REFRESH_SECRET=88bf3b10f71487fc18308bde39d2da128e277824b1b5b0064065c8f0788fc135
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072

# ── Pinecone ──────────────────────────────────────────────────
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=ai-support-index
PINECONE_ENVIRONMENT=us-east-1-aws

# ── RAG Pipeline ──────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
MIN_SIMILARITY_SCORE=0.75

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
